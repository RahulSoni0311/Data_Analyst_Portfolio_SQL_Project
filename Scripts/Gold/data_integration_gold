-- Check gender integration
-- Verify that the final gender value follows the source-priority rule:
-- CRM gender is preferred; if unavailable, use ERP gender; otherwise use 'N/A'

SELECT DISTINCT
    ci.cst_gndr,
    ca.gen,
    CASE
        WHEN ci.cst_gndr != 'N/A' THEN ci.cst_gndr
        ELSE COALESCE(ca.gen, 'N/A')
    END AS new_gen
FROM silver.crm_cust_info AS ci
LEFT JOIN silver.erp_cust_az12 AS ca
    ON ci.cst_key = ca.cid
ORDER BY 1, 2;
